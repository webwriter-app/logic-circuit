        <target>அனைத்து வாயில்களையும் இணைப்புகளையும் அகற்றவா?</target>
      </trans-unit>
      <trans-unit id="sb8c878135ee917b1">
        <source>The file is not valid JSON.</source>
        <target>கோப்பு சரியான JSON அல்ல.</target>
      </trans-unit>
      <trans-unit id="sde5b9e662c21c136">
